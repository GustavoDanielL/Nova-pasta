{
  "name": "financepro-electron-frontend",
  "version": "0.1.0",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.3.0"
  },
  "build": {
    "appId": "com.financepro.app",
    "productName": "FinancePro",
    "files": ["**/*"],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": ["AppImage","deb"],
      "category": "Office"
    }
  }
}
