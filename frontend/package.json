{
  "name": "financepro",
  "version": "2.0.0",
  "description": "Sistema de Gestão de Empréstimos e Finanças",
  "main": "electron.js",
  "author": "FinancePro Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:linux:appimage": "electron-builder --linux AppImage",
    "build:linux:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win",
    "clean": "rm -rf dist build_output"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.financepro.app",
    "productName": "FinancePro",
    "copyright": "Copyright © 2024-2026 FinancePro",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!__pycache__/**"]
      },
      {
        "from": "../models",
        "to": "models",
        "filter": ["**/*", "!__pycache__/**"]
      },
      {
        "from": "../utils",
        "to": "utils",
        "filter": ["**/*", "!__pycache__/**"]
      },
      {
        "from": "../config.py",
        "to": "config.py"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icons",
      "category": "Office;Finance",
      "maintainer": "FinancePro Team",
      "synopsis": "Sistema de Gestão de Empréstimos",
      "description": "FinancePro é um sistema completo para gestão de empréstimos pessoais, controle de clientes e acompanhamento financeiro.",
      "desktop": {
        "Name": "FinancePro",
        "Comment": "Sistema de Gestão de Empréstimos",
        "Categories": "Office;Finance;",
        "Keywords": "finance;loans;money;emprestimo;financeiro;"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinancePro"
    },
    "publish": null
  }
}
